  <joint name="desistek_saga/camera_optical_joint" type="revolute">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="desistek_saga/camera_link"/>
    <child link="desistek_saga/camera_link_optical"/>
    <limit effort="0" lower="0" upper="0" velocity="0"/>
